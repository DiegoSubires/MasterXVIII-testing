{
  "name": "origin-front-admin",
  "version": "1.0.0",
  "description": "",
  "type": "module",
  "scripts": {
    "start": "run-p -l type-check:watch start:dev",
    "start:dev": "vite",
    "start:preview": "vite preview --port 4173",
    "build": "run-p -l type-check build:prod",
    "build:prod": "npm run clean && vite build",
    "type-check": "tsc --noEmit",
    "type-check:watch": "npm run type-check -- --watch",
    "test": "vitest -c ./config/test/config.ts",
    "test:unit": "vitest run -c ./config/test/config.ts",
    "test:e2e:playwright": "playwright test",
    "test:e2e:playwright:ui": "playwright test --ui",
    "test:e2e:cypress:run": "cypress run",
    "test:e2e:cypress:open": "cypress open",
    "test:e2e": "start-server-and-test start:preview http://localhost:4173 \"npm run test:e2e:playwright && npm run test:e2e:cypress:run\"",
    "test:all": "npm run test:unit && npm run test:e2e",
    "clean": "rimraf dist"
  },
  "imports": {
    "#*": "./src/*"
  },
  "author": "Lemoncode",
  "license": "MIT",
  "dependencies": {
    "@emotion/css": "^11.13.5",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@lemoncode/fonk": "^1.5.4",
    "@lemoncode/fonk-formik": "^4.0.1",
    "@lemoncode/fonk-match-field-validator": "^1.0.1",
    "@lemoncode/fonk-required-by-field-validator": "^1.0.1",
    "@mui/icons-material": "^9.2.0",
    "@mui/material": "^9.2.0",
    "@tanstack/react-table": "^8.21.3",
    "axios": "^1.18.1",
    "formik": "^2.4.9",
    "graphql-request": "^7.4.0",
    "immer": "^11.1.11",
    "lodash.flowright": "^3.5.0",
    "lodash.get": "^4.4.2",
    "lodash.merge": "^4.6.2",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-promise-tracker": "^2.1.1",
    "react-router-dom": "^7.18.1",
    "react-spinners": "^0.17.0"
  },
  "devDependencies": {
    "@babel/core": "^7.28.0",
    "@babel/preset-typescript": "^7.26.0",
    "@bahmutov/cypress-esbuild-preprocessor": "^2.2.8",
    "@cypress/vite-dev-server": "^7.3.4",
    "@cypress/webpack-preprocessor": "^7.1.1",
    "@playwright/test": "^1.62.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "cypress": "^15.19.0",
    "cypress-vite": "^1.10.2",
    "esbuild": "^0.28.1",
    "jsdom": "^29.1.1",
    "kill-port": "^2.0.1",
    "npm-run-all": "^4.1.5",
    "rimraf": "^6.1.3",
    "start-server-and-test": "^3.0.11",
    "ts-loader": "^9.6.2",
    "typescript": "^7.0.2",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  }
}
